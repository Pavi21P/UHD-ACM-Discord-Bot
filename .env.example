DISCORD_TOKEN=replace_with_bot_token
CLIENT_ID=replace_with_application_id
# Set GUILD_ID to register only for your server; leave empty for global commands.
GUILD_ID=
# Assign existing warning history to its original server (especially with global commands).
LEGACY_WARNINGS_GUILD_ID=
# Optional QOTD destination; leave empty to disable QOTD.
QOTD_CHANNEL_ID=
QOTD_TIMEZONE=America/Chicago
# Optional notifications:
HEARTBEAT_CHANNEL_ID=
SHUTDOWN_NOTIFY_USER_ID=
# Optional HTTP health endpoint. Not required to run a Discord bot.
PORT=
